{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jarvis",
  "version": "0.1.0",
  "identifier": "com.jarvis.voice",
  "build": { "frontendDist": "../frontend" },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [{
      "label": "main", "title": "Jarvis", "width": 160, "height": 160, "create": false, "useHttpsScheme": true,
      "transparent": true, "decorations": false, "alwaysOnTop": true,
      "skipTaskbar": true, "resizable": false, "shadow": false,
      "backgroundThrottling": "disabled"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost https://ipc.localhost; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.ico", "icons/icon.icns", "icons/icon.png"] }
}
